# Backend address. Always https:// (locally: https://localhost:3001, see
# the backend README "HTTPS").
NEXT_PUBLIC_API_BASE_URL=https://localhost:3001

# Support contacts shown on the Help page (leave empty to hide)
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
# International format, e.g. +213555123456
NEXT_PUBLIC_SUPPORT_WHATSAPP=
# e.g. Sun–Thu, 9:00–17:00
NEXT_PUBLIC_SUPPORT_HOURS=

# Store pages of the employee app (Nexo Inouty), once it is published.
# Empty: the Mobile app page says the app isn't on the stores yet, and the
# sign-in messages sent to employees say the link will follow.
NEXT_PUBLIC_ANDROID_APP_URL=
NEXT_PUBLIC_IOS_APP_URL=
